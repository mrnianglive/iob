# =============================================================================
# IOB Partner API - Configuration Environment
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
MYSQL_ROOT_PASSWORD=iob_root_password_change_in_production
MYSQL_DATABASE=iob_database
MYSQL_USER=iob_user
MYSQL_PASSWORD=iob_password_change_in_production

# URL de connexion complète (utilisée par l'API)
DATABASE_URL=mysql://iob_user:iob_password_change_in_production@localhost:3306/iob_database

# =============================================================================
# PARTNER API CONFIGURATION
# =============================================================================
NODE_ENV=production
PARTNER_API_PORT=3001
API_PREFIX=/partner-api

# JWT & Security
PARTNER_JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
HMAC_SECRET=your-hmac-secret-for-api-signatures-change-in-production

# CORS Configuration
CORS_ORIGIN=http://localhost:8081,https://partner.iob.com,https://your-domain.com
CORS_CREDENTIALS=true

# Rate Limiting
API_RATE_LIMIT=1000
API_WINDOW_MS=900000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
PARTNER_FRONTEND_PORT=8081
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=IOB Partner Portal
VITE_APP_VERSION=1.0.0

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FILE=logs/partner-api.log

# =============================================================================
# EMAIL CONFIGURATION (Optionnel)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-app-password
FROM_EMAIL=noreply@iob.com

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================
WEBHOOK_TIMEOUT=5000
WEBHOOK_RETRY_ATTEMPTS=3

# =============================================================================
# API DOCUMENTATION
# =============================================================================
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

# =============================================================================
# MONITORING CONFIGURATION (Optionnel)
# =============================================================================
ENABLE_METRICS=true
METRICS_PATH=/metrics

# Grafana
GRAFANA_ADMIN_PASSWORD=admin123_change_in_production

# =============================================================================
# SSL/TLS CONFIGURATION (Production)
# =============================================================================
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=iob-backups
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# =============================================================================
# PARTNER SPECIFIC CONFIGURATION
# =============================================================================

# Configuration par défaut pour nouveaux partenaires
DEFAULT_RATE_LIMIT=1000
DEFAULT_ANALYTICS_ENABLED=true
DEFAULT_EXPORT_ENABLED=true
DEFAULT_WEBHOOKS_ENABLED=false
DEFAULT_API_ACCESS_ENABLED=true

# =============================================================================
# DEVELOPMENT/STAGING OVERRIDES
# =============================================================================

# Décommentez pour l'environnement de développement
# NODE_ENV=development
# LOG_LEVEL=debug
# SWAGGER_ENABLED=true
# CORS_ORIGIN=*

# Décommentez pour l'environnement de staging
# NODE_ENV=staging
# DATABASE_URL=mysql://staging_user:staging_pass@staging-db:3306/iob_staging
# PARTNER_JWT_SECRET=staging-jwt-secret-different-from-production
# CORS_ORIGIN=https://staging-partner.iob.com

# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# IMPORTANT: 
# 1. Changez TOUS les mots de passe et secrets en production
# 2. Utilisez des secrets d'au moins 32 caractères
# 3. Ne commitez JAMAIS ce fichier avec les vraies valeurs
# 4. Utilisez un gestionnaire de secrets en production (AWS Secrets Manager, etc.)
# 5. Activez le HTTPS en production
# 6. Configurez un firewall approprié
# 7. Surveillez les logs pour détecter les tentatives d'intrusion
#
# =============================================================================