# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/iob_database"

# Server Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=/partner-api

# JWT Configuration
PARTNER_JWT_SECRET=your-super-secret-jwt-key-for-partners
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis Configuration (for caching and rate limiting)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# API Security
API_RATE_LIMIT=1000
API_WINDOW_MS=900000
HMAC_SECRET=your-hmac-secret-for-api-signatures

# CORS Configuration
CORS_ORIGIN=http://localhost:8081,https://partner.iob.com
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info
LOG_FILE=logs/partner-api.log

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
FROM_EMAIL=noreply@iob.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Webhook Configuration
WEBHOOK_TIMEOUT=5000
WEBHOOK_RETRY_ATTEMPTS=3

# Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

# Monitoring
ENABLE_METRICS=true
METRICS_PATH=/metrics