# Database
DATABASE_URL="mysql://user:password@localhost:3306/cp1146011p43_iob"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret
